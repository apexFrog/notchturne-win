<Window x:Class="NotchturneWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки NotchturneWin"
        Width="460" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EAEAEF"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EAEAEF"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#25252C"/>
      <Setter Property="Foreground" Value="#111114"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="BorderBrush" Value="#3A3A44"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <Border Background="#111114" CornerRadius="18" BorderBrush="#2A2A32" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.7"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="52"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Background="#17171C" CornerRadius="18,18,0,0" MouseLeftButtonDown="OnTitleDrag">
        <Grid Margin="18,0,12,0">
          <TextBlock Text="Настройки NotchturneWin" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Width="30" Height="30" Background="Transparent" BorderThickness="0"
                  Foreground="#999" FontSize="14" Cursor="Hand" Click="OnClose"/>
        </Grid>
      </Border>

      <!-- Content -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
        <StackPanel>
          <!-- Section: Lyrics -->
          <TextBlock Text="ТЕКСТ ПЕСНИ" FontSize="11" FontWeight="SemiBold" Foreground="#7A7A88" Margin="2,4,0,8"/>
          <Border Background="#1A1A20" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Где отображать" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="PlacementBox" Grid.Column="1" SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Tag="Notch" Content="В острове"/>
                  <ComboBoxItem Tag="Floating" Content="Плавающее окно"/>
                  <ComboBoxItem Tag="NotchAndFloating" Content="В острове + Плавающее"/>
                  <ComboBoxItem Tag="Hidden" Content="Скрыть"/>
                </ComboBox>
              </Grid>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Режим текста" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="ModeBox" Grid.Column="1" SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Tag="Karaoke" Content="Караоке (подсветка)"/>
                  <ComboBoxItem Tag="Bounce" Content="Прыгающие буквы"/>
                  <ComboBoxItem Tag="Typing" Content="Печать (с курсором)"/>
                  <ComboBoxItem Tag="Classic" Content="Классический"/>
                  <ComboBoxItem Tag="SingleLine" Content="Одна строка"/>
                </ComboBox>
              </Grid>

              <CheckBox x:Name="MiniLyricsCheck" Content="Показывать текущую строку в свёрнутом острове"
                        Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сдвиг текста (сек)" VerticalAlignment="Center" FontSize="13"/>
                <Slider x:Name="OffsetSlider" Grid.Column="1" Minimum="-3" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSettingChanged"/>
                <TextBlock x:Name="OffsetVal" Grid.Column="2" Text="+0.2s" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AAA" FontSize="12"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Section: Floating Overlay -->
          <TextBlock Text="ПЛАВАЮЩЕЕ ОКНО ТЕКСТА" FontSize="11" FontWeight="SemiBold" Foreground="#7A7A88" Margin="2,0,0,8"/>
          <Border Background="#1A1A20" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Позиция" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="FloatPosBox" Grid.Column="1" SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Tag="BottomCenter" Content="Снизу по центру"/>
                  <ComboBoxItem Tag="TopBelowNotch" Content="Сверху под островом"/>
                  <ComboBoxItem Tag="Custom" Content="Своя (перетащить)"/>
                </ComboBox>
              </Grid>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Размер шрифта" VerticalAlignment="Center" FontSize="13"/>
                <Slider x:Name="FloatSizeSlider" Grid.Column="1" Minimum="14" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnSettingChanged"/>
                <TextBlock x:Name="FloatSizeVal" Grid.Column="2" Text="22" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AAA" FontSize="12"/>
              </Grid>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Прозрачность" VerticalAlignment="Center" FontSize="13"/>
                <Slider x:Name="FloatOpSlider" Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnSettingChanged"/>
                <TextBlock x:Name="FloatOpVal" Grid.Column="2" Text="92%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AAA" FontSize="12"/>
              </Grid>

              <CheckBox x:Name="ClickThroughCheck" Content="Пропускать клики (сними, чтобы перетащить окно)"
                        Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
            </StackPanel>
          </Border>

          <!-- Section: Artwork & Interface -->
          <TextBlock Text="ИНТЕРФЕЙС И ОБЛОЖКИ" FontSize="11" FontWeight="SemiBold" Foreground="#7A7A88" Margin="2,0,0,8"/>
          <Border Background="#1A1A20" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
              <CheckBox x:Name="HdCoverCheck" Content="Загружать HD-обложки из Apple Music (iTunes / Deezer)"
                        Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
              <CheckBox x:Name="CalendarCheck" Content="Показывать календарь в острове"
                        Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
              <CheckBox x:Name="ClipboardCheck" Content="Показывать историю буфера обмена"
                        Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
            </StackPanel>
          </Border>

          <!-- Section: Media Sources -->
          <TextBlock Text="ИСТОЧНИКИ МЕДИА (ФИЛЬТР)" FontSize="11" FontWeight="SemiBold" Foreground="#7A7A88" Margin="2,0,0,8"/>
          <Border Background="#1A1A20" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
            <StackPanel>
              <CheckBox x:Name="IgnoreBrowsersCheck" Content="Игнорировать браузеры (Chrome, Edge, Firefox, Opera…)"
                        Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
              <TextBlock Text="Обнаруженные плееры (сними галочку, чтобы отключить):" FontSize="12" Foreground="#888894" Margin="0,8,0,6"/>
              <StackPanel x:Name="AppsPanel"/>

              <TextBlock Text="Добавить исключение вручную (например: telegram, discord, vlc):" FontSize="12" Foreground="#888894" Margin="0,10,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BlockInput" Background="#25252C" Foreground="White" CaretBrush="White"
                         BorderBrush="#3A3A44" BorderThickness="1" Padding="8,5" FontSize="13"/>
                <Button Grid.Column="1" Content="Исключить" Margin="8,0,0,0" Padding="12,5"
                        Background="#2E2E38" Foreground="White" BorderThickness="0" Cursor="Hand" Click="OnAddBlocked"/>
              </Grid>
              <WrapPanel x:Name="BlockedTagsPanel" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="2" Background="#17171C" CornerRadius="0,0,18,18" Padding="18,0">
        <Grid>
          <TextBlock Text="Изменения применяются сразу" FontSize="12" Foreground="#777784" VerticalAlignment="Center"/>
          <Button Content="Готово" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Padding="18,6" Background="#FFFFFF" Foreground="#111114" FontWeight="SemiBold"
                  BorderThickness="0" Cursor="Hand" Click="OnClose"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
