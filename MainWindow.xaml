            <TextBlock x:Name="ClipHeaderTitle" Text="CLIPBOARD" Foreground="#7A7A80" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ClipList"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <!-- Inline Settings View inside the Notch (matching screenshot!) -->
      <Grid x:Name="SettingsView" Margin="34,14,22,18" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
        <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-4,-6,0" Padding="6" Click="CloseSettings" Panel.ZIndex="10">
          <TextBlock Text="✕" Foreground="#6E6E73" FontSize="14" FontWeight="SemiBold"/>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,16,0">
