          <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                Fill="#6E6E73" Stretch="Uniform" Width="14" Height="14"/>
        </Button>

        <Grid Margin="18,16,32,16" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Width="112" Height="112" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border CornerRadius="18" Background="#1A1A1E">
              <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
              </Border.Effect>
              <Border CornerRadius="18" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush x:Name="CornerArtBrush" Stretch="UniformToFill"/>
                </Border.Background>
                <Border CornerRadius="18" BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
              </Border>
            </Border>
            <Border x:Name="CornerSourceBadge" Width="22" Height="22" CornerRadius="7"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                    Background="#FA2D48" BorderBrush="#CC000000" BorderThickness="1.5" Visibility="Collapsed">
              <TextBlock x:Name="CornerSourceBadgeText" Text="♪" Foreground="White" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>

          <Grid Grid.Column="1" Margin="14,2,6,2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock x:Name="CornerTitleText" Text="Ничего не играет" Foreground="White" FontSize="15.5"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="CornerArtistText" Text="" Foreground="#8E8E93" FontSize="12.5"
                         Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,10,0,8">
              <Grid x:Name="SeekTrackCorner" Height="14" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="SeekCornerDown" MouseMove="SeekCornerMove">
                <Border Height="3.5" CornerRadius="2" Background="#3A3A3C" VerticalAlignment="Center"/>
                <Border x:Name="ProgressFillCorner" Height="3.5" CornerRadius="2" Background="White"
                        HorizontalAlignment="Left" Width="0" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,2,0,0">
                <TextBlock x:Name="ElapsedTextCorner" Text="0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Left"/>
                <TextBlock x:Name="RemainingTextCorner" Text="-0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>

            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Button x:Name="ModeQuickBtnCorner" Style="{StaticResource IconBtn}" Padding="4" Click="CycleLyricsMode"
                      ToolTip="Сменить режим текста">
                <TextBlock Text="♪" Foreground="#FF3B5C" FontSize="14" FontWeight="Bold"/>
              </Button>

              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Padding="8,4" Click="Prev" ToolTip="Предыдущий">
                  <Path Data="M11,18V6l-8.5,6L11,18z M11.5,12l8.5,6V6L11.5,12z"
                        Fill="White" Stretch="Uniform" Width="17" Height="13"/>
                </Button>
                <Button Style="{StaticResource IconBtn}" Padding="10,4" Click="PlayPause" ToolTip="Пауза / Воспроизведение">
                  <Path x:Name="PlayPauseIconCorner" Data="M8,5v14l11-7L8,5z"
                        Fill="White" Stretch="Uniform" Width="15" Height="16"/>
                </Button>
                <Button Style="{StaticResource IconBtn}" Padding="8,4" Click="Next" ToolTip="Следующий">
                  <Path Data="M4,18l8.5-6L4,6V18z M13,6v12l8.5-6L13,6z"
                        Fill="White" Stretch="Uniform" Width="17" Height="13"/>
                </Button>
              </StackPanel>

              <Button x:Name="SourceStatusBtnCorner" Grid.Column="2" Style="{StaticResource IconBtn}" Padding="4" Click="OpenSettings"
                      ToolTip="Источник медиа (настройки)">
                <Border x:Name="SourceStatusDotCorner" Width="14" Height="14" CornerRadius="7" Background="#1DB954">
                  <TextBlock Text="✓" Foreground="Black" FontSize="9" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Button>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <!-- Expanded: Vertical Arm (Lyrics flowing down/up along the screen edge!) -->
      <Grid x:Name="CornerFullVert" Width="244" Height="280" Opacity="0" IsHitTestVisible="False">
        <Grid Margin="14,10,14,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="CornerLyricsDividerTop" Grid.Row="0" Height="1" Background="#24FFFFFF" Margin="4,0,4,10"/>
          <controls:LyricsView x:Name="CornerLyrics" Grid.Row="1" VerticalAlignment="Stretch"/>
          <Border x:Name="CornerLyricsDividerBot" Grid.Row="2" Height="1" Background="#24FFFFFF" Margin="4,10,4,0" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Canvas>
  </Grid>
  </Grid>
</Window>
