        <MenuItem x:Name="CtxCornerResetPos" Header="Сбросить позицию (вверх по центру)" Click="ResetNotchPosition"/>
        <Separator/>
        <MenuItem x:Name="CtxCornerQuit" Header="Выход" Click="Quit"/>
      </ContextMenu>
    </Grid.ContextMenu>

    <!-- Unified L-shaped background + glass border -->
    <Path x:Name="CornerBgPath" Fill="#FF000000" Stroke="#26FFFFFF" StrokeThickness="1"/>

    <!-- Shimmer & ambient glow clipped to the exact L-shaped PathGeometry -->
    <Grid x:Name="CornerBgClipHost" IsHitTestVisible="False">
      <Border x:Name="CornerGlowLayer" IsHitTestVisible="False" Visibility="Collapsed"/>
      <controls:CoverShimmerLayer x:Name="CornerShimmer" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>

