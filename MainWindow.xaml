                  <Button Content="+" Style="{StaticResource SegPill}" Background="Transparent" Padding="10,3" Click="OnClipPlus"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblLang" Text="Язык" Style="{StaticResource SettingRowLabel}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLangRu" Content="Рус" Style="{StaticResource SegPill}" Margin="0,0,6,0" Click="OnLangRu"/>
