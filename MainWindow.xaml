<Window x:Class="NotchturneWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NotchturneWin.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="250" Height="34" Top="0">
  <Window.Resources>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- iOS-style green toggle switch (matching screenshot) -->
    <Style x:Key="IosSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#2E2E33">
              <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="ThumbShift" X="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#34C759"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Compact pill button for segmented choices & steppers -->
    <Style x:Key="SegPill" TargetType="Button">
      <Setter Property="Background" Value="#1E1E22"/>
      <Setter Property="Foreground" Value="#8E8E93"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingRowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingSep" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#18181C"/>
      <Setter Property="Margin" Value="0,9"/>
    </Style>
  </Window.Resources>

  <Border x:Name="NotchShell" Background="#FF000000" CornerRadius="0,0,26,26"
          BorderBrush="#1AFFFFFF" BorderThickness="1,0,1,1">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem x:Name="CtxSettings" Header="Настройки…" Click="OpenSettings"/>
        <MenuItem x:Name="CtxCycleMode" Header="Сменить режим текста" Click="CycleLyricsMode"/>
        <Separator/>
        <MenuItem x:Name="CtxQuit" Header="Выход" Click="Quit"/>
      </ContextMenu>
    </Border.ContextMenu>

    <Grid>
      <!-- Ambient Cover / Glass Glow Layer -->
      <Border x:Name="NotchGlowLayer" CornerRadius="0,0,26,26" IsHitTestVisible="False" Visibility="Collapsed"/>

      <!-- Collapsed Mini Bar -->
      <Grid x:Name="Mini" Margin="14,0" VerticalAlignment="Top" Height="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="MiniArtBox" Width="20" Height="20" CornerRadius="5" Background="#1C1C20" ClipToBounds="True" Margin="0,0,9,0" VerticalAlignment="Center">
          <Image x:Name="MiniArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="MiniText" Foreground="#F2F2F7" FontSize="12" FontWeight="Medium"
                     TextTrimming="CharacterEllipsis" Text="Ничего не играет"/>
          <TextBlock x:Name="MiniLyricText" Foreground="#B8B8C2" FontSize="11.5" FontWeight="Normal"
                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <Ellipse x:Name="MiniDot" Grid.Column="2" Width="6" Height="6" Fill="#1DB954" Margin="8,0,0,0"
                 VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>

      <!-- Expanded Wide Notch (Player + Lyrics + Calendar + Clipboard) -->
      <Grid x:Name="Full" Margin="20,16,20,16" Opacity="0" IsHitTestVisible="False">
        <!-- Settings Gear top-right -->
        <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-8,-8,0" Padding="5" ToolTip="Настройки" Click="OpenSettings" Panel.ZIndex="10">
          <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                Fill="#6E6E73" Stretch="Uniform" Width="14" Height="14"/>
        </Button>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition x:Name="ColLyricsDiv" Width="Auto"/>
            <ColumnDefinition x:Name="ColLyrics" Width="230"/>
            <ColumnDefinition x:Name="ColCalDiv" Width="Auto"/>
            <ColumnDefinition x:Name="ColCal" Width="188"/>
            <ColumnDefinition x:Name="ColClipDiv" Width="Auto"/>
            <ColumnDefinition x:Name="ColClip" Width="178"/>
          </Grid.ColumnDefinitions>

          <!-- Column 1: Media Player -->
          <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="122"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Width="116" Height="116" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Border CornerRadius="12" Background="#1A1A1E" ClipToBounds="True">
                <Image x:Name="ArtImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <Border x:Name="SourceBadge" Width="22" Height="22" CornerRadius="6"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
                      Background="#FA2D48" BorderBrush="#CC000000" BorderThickness="1.5" Visibility="Collapsed">
                <TextBlock x:Name="SourceBadgeText" Text="♪" Foreground="White" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="14,4,4,2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" Text="Ничего не играет" Foreground="White" FontSize="15.5"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Text="" Foreground="#8E8E93" FontSize="12.5"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,12,0,10">
                <Grid x:Name="SeekTrack" Height="14" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="SeekDown" MouseMove="SeekMove">
                  <Border Height="3.5" CornerRadius="2" Background="#3A3A3C" VerticalAlignment="Center"/>
                  <Border x:Name="ProgressFill" Height="3.5" CornerRadius="2" Background="White"
                          HorizontalAlignment="Left" Width="0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,2,0,0">
                  <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="RemainingText" Text="-0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>

              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ModeQuickBtn" Style="{StaticResource IconBtn}" Padding="4" Click="CycleLyricsMode"
                        ToolTip="Сменить режим текста">
                  <TextBlock x:Name="ModeQuickGlyph" Text="♪" Foreground="#FF3B5C" FontSize="14" FontWeight="Bold"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconBtn}" Padding="8,4" Click="Prev" ToolTip="Предыдущий">
                    <Path Data="M11,18V6l-8.5,6L11,18z M11.5,12l8.5,6V6L11.5,12z"
                          Fill="White" Stretch="Uniform" Width="17" Height="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Padding="10,4" Click="PlayPause" ToolTip="Пауза / Воспроизведение">
                    <Path x:Name="PlayPauseIcon" Data="M8,5v14l11-7L8,5z"
                          Fill="White" Stretch="Uniform" Width="15" Height="16"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Padding="8,4" Click="Next" ToolTip="Следующий">
                    <Path Data="M4,18l8.5-6L4,6V18z M13,6v12l8.5-6L13,6z"
                          Fill="White" Stretch="Uniform" Width="17" Height="13"/>
                  </Button>
                </StackPanel>

                <Button x:Name="SourceStatusBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Padding="4" Click="OpenSettings"
                        ToolTip="Источник медиа (настройки)">
                  <Border x:Name="SourceStatusDot" Width="14" Height="14" CornerRadius="7" Background="#1DB954">
                    <TextBlock Text="✓" Foreground="Black" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Button>
              </Grid>
            </Grid>
          </Grid>

          <!-- Divider 1 -->
          <Border x:Name="DivLyrics" Grid.Column="1" Width="1" Background="#1E1E22" Margin="14,10,16,10"/>

          <!-- Column 2: Lyrics -->
          <controls:LyricsView x:Name="NotchLyrics" Grid.Column="2" VerticalAlignment="Stretch" Margin="0,2,0,2"/>

          <!-- Divider 2 -->
          <Border x:Name="DivCal" Grid.Column="3" Width="1" Background="#1E1E22" Margin="14,10,16,10"/>

          <!-- Column 3: Calendar -->
          <Grid x:Name="CalendarPanel" Grid.Column="4" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="CalMonthTitle" Text="NOVEMBER 2026" Foreground="#7A7A80" FontSize="10.5"
                       FontWeight="SemiBold" Margin="2,0,0,7"/>
            <UniformGrid x:Name="CalWeekdaysGrid" Grid.Row="1" Columns="7" Margin="0,0,0,5"/>
            <UniformGrid x:Name="CalDaysGrid" Grid.Row="2" Columns="7"/>
          </Grid>

          <!-- Divider 3 -->
          <Border x:Name="DivClip" Grid.Column="5" Width="1" Background="#1E1E22" Margin="14,10,16,10"/>

          <!-- Column 4: Clipboard History -->
          <Grid x:Name="ClipboardPanel" Grid.Column="6" VerticalAlignment="Stretch" Margin="0,12,12,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="ClipHeaderTitle" Text="CLIPBOARD" Foreground="#7A7A80" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ClipList"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <!-- Inline Settings View inside the Notch (matching screenshot!) -->
      <Grid x:Name="SettingsView" Margin="34,14,22,18" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
        <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-4,-6,0" Padding="6" Click="CloseSettings" Panel.ZIndex="10">
          <TextBlock Text="✕" Foreground="#6E6E73" FontSize="14" FontWeight="SemiBold"/>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,16,0">
          <StackPanel Margin="0,0,8,4">
            <!-- WHAT TO SHOW -->
            <TextBlock x:Name="LblSecShow" Text="ЧТО ПОКАЗЫВАТЬ" Foreground="#6E6E73" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Grid>
              <TextBlock x:Name="LblShowLyrics" Text="Текст песни" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwLyrics" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblShowCal" Text="Календарь" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwCalendar" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblShowClip" Text="Буфер обмена" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwClipboard" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblHdArt" Text="HD-обложки (Apple Music)" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwHdArt" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblClipCount" Text="Записей в буфере" Style="{StaticResource SettingRowLabel}"/>
              <Border Background="#1B1B1F" CornerRadius="8" HorizontalAlignment="Right" Padding="2">
                <StackPanel Orientation="Horizontal">
                  <Button Content="−" Style="{StaticResource SegPill}" Background="Transparent" Padding="10,3" Click="OnClipMinus"/>
                  <TextBlock x:Name="TxtClipCount" Text="5" Foreground="White" FontSize="13" FontWeight="SemiBold"
                             VerticalAlignment="Center" MinWidth="22" TextAlignment="Center"/>
                  <Button Content="+" Style="{StaticResource SegPill}" Background="Transparent" Padding="10,3" Click="OnClipPlus"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblLang" Text="Язык" Style="{StaticResource SettingRowLabel}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLangRu" Content="Рус" Style="{StaticResource SegPill}" Margin="0,0,6,0" Click="OnLangRu"/>
                <Button x:Name="BtnLangEn" Content="Eng" Style="{StaticResource SegPill}" Click="OnLangEn"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblBgMode" Text="Фон острова" Style="{StaticResource SettingRowLabel}"/>
              <WrapPanel HorizontalAlignment="Right" MaxWidth="310">
                <Button x:Name="BtnBgBlack" Content="Чёрный" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnBgBlack"/>
                <Button x:Name="BtnBgGlass" Content="Стекло" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnBgGlass"/>
                <Button x:Name="BtnBgCoverGlass" Content="Обложка + Стекло" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnBgCoverGlass"/>
                <Button x:Name="BtnBgCoverBlack" Content="Обложка + Чёрный" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnBgCoverBlack"/>
              </WrapPanel>
            </Grid>

            <!-- LYRICS SETTINGS -->
            <TextBlock x:Name="LblSecLyrics" Text="НАСТРОЙКИ ТЕКСТА" Foreground="#6E6E73" FontSize="10.5" FontWeight="SemiBold" Margin="0,20,0,12"/>

            <Grid>
              <TextBlock x:Name="LblPlacement" Text="Где показывать" Style="{StaticResource SettingRowLabel}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnPlaceNotch" Content="Остров" Style="{StaticResource SegPill}" Padding="9,4" Margin="0,0,4,0" Click="OnPlaceNotch"/>
                <Button x:Name="BtnPlaceFloat" Content="Окно" Style="{StaticResource SegPill}" Padding="9,4" Margin="0,0,4,0" Click="OnPlaceFloat"/>
                <Button x:Name="BtnPlaceBoth" Content="Оба" Style="{StaticResource SegPill}" Padding="9,4" Click="OnPlaceBoth"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblMode" Text="Режим текста" Style="{StaticResource SettingRowLabel}"/>
              <WrapPanel HorizontalAlignment="Right" MaxWidth="290">
                <Button x:Name="BtnModeKaraoke" Content="Караоке" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnModeKaraoke"/>
                <Button x:Name="BtnModeBounce" Content="Прыжки" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnModeBounce"/>
                <Button x:Name="BtnModeTyping" Content="Печать" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnModeTyping"/>
                <Button x:Name="BtnModeClassic" Content="Классика" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnModeClassic"/>
                <Button x:Name="BtnModeSingle" Content="1 строка" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnModeSingle"/>
              </WrapPanel>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblLockLine" Text="Фиксация на текущей строке" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwLockLine" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblMiniLyrics" Text="Строка в свёрнутом острове" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwMiniLyrics" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblMiniStyle" Text="Вид в свёрнутом острове" Style="{StaticResource SettingRowLabel}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMiniBelow" Content="Под названием" Style="{StaticResource SegPill}" Padding="9,4" Margin="0,0,4,0" Click="OnMiniBelow"/>
                <Button x:Name="BtnMiniReplace" Content="Вместо названия" Style="{StaticResource SegPill}" Padding="9,4" Click="OnMiniReplace"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblOffset" Text="Сдвиг текста (сек)" Style="{StaticResource SettingRowLabel}"/>
              <Border Background="#1B1B1F" CornerRadius="8" HorizontalAlignment="Right" Padding="2">
                <StackPanel Orientation="Horizontal">
                  <Button Content="−" Style="{StaticResource SegPill}" Background="Transparent" Padding="10,3" Click="OnOffsetMinus"/>
                  <TextBlock x:Name="TxtOffset" Text="+0.2s" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                             VerticalAlignment="Center" MinWidth="42" TextAlignment="Center"/>
                  <Button Content="+" Style="{StaticResource SegPill}" Background="Transparent" Padding="10,3" Click="OnOffsetPlus"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- FLOATING WINDOW -->
            <TextBlock x:Name="LblSecFloat" Text="ПЛАВАЮЩЕЕ ОКНО" Foreground="#6E6E73" FontSize="10.5" FontWeight="SemiBold" Margin="0,20,0,12"/>

            <Grid>
              <TextBlock x:Name="LblFloatPos" Text="Позиция" Style="{StaticResource SettingRowLabel}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnPosBottom" Content="Снизу" Style="{StaticResource SegPill}" Padding="9,4" Margin="0,0,4,0" Click="OnFloatBottom"/>
                <Button x:Name="BtnPosTop" Content="Сверху" Style="{StaticResource SegPill}" Padding="9,4" Margin="0,0,4,0" Click="OnFloatTop"/>
                <Button x:Name="BtnPosCustom" Content="Своя" Style="{StaticResource SegPill}" Padding="9,4" Click="OnFloatCustom"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblFloatSize" Text="Размер шрифта" Style="{StaticResource SettingRowLabel}"/>
              <Border Background="#1B1B1F" CornerRadius="8" HorizontalAlignment="Right" Padding="2">
                <StackPanel Orientation="Horizontal">
                  <Button Content="−" Style="{StaticResource SegPill}" Background="Transparent" Padding="10,3" Click="OnFontMinus"/>
                  <TextBlock x:Name="TxtFontSize" Text="22" Foreground="White" FontSize="13" FontWeight="SemiBold"
                             VerticalAlignment="Center" MinWidth="28" TextAlignment="Center"/>
                  <Button Content="+" Style="{StaticResource SegPill}" Background="Transparent" Padding="10,3" Click="OnFontPlus"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblClickThrough" Text="Пропускать клики (закрепить)" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwClickThrough" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>

            <!-- MEDIA SOURCES -->
            <TextBlock x:Name="LblSecMedia" Text="ИСТОЧНИКИ МЕДИА" Foreground="#6E6E73" FontSize="10.5" FontWeight="SemiBold" Margin="0,20,0,12"/>

            <Grid>
              <TextBlock x:Name="LblIgnoreBrowsers" Text="Игнорировать браузеры" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwIgnoreBrowsers" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <StackPanel x:Name="InlineAppsPanel"/>

            <Grid Margin="0,8,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="InlineBlockInput" Background="#1B1B1F" Foreground="White" CaretBrush="White"
                       BorderBrush="#2C2C33" BorderThickness="1" Padding="8,5" FontSize="12.5"
                       ToolTip="Например: telegram, discord, vlc"/>
              <Button x:Name="BtnAddBlock" Grid.Column="1" Content="Исключить" Style="{StaticResource SegPill}"
                      Background="#2A2A32" Foreground="White" Margin="8,0,0,0" Click="OnInlineAddBlock"/>
            </Grid>
            <WrapPanel x:Name="InlineBlockedTags" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
