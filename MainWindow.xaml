              <Button x:Name="BtnAddBlock" Grid.Column="1" Content="Исключить" Style="{StaticResource SegPill}"
                      Background="#2A2A32" Foreground="White" Margin="8,0,0,0" Click="OnInlineAddBlock"/>
            </Grid>
            <WrapPanel x:Name="InlineBlockedTags" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>

  <!-- Corner-Wrap L-Shaped Dynamic Island (Beta: bends seamlessly around screen corners!) -->
  <Grid x:Name="CornerShell" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
        Width="600" Height="460"
        MouseLeftButtonDown="NotchShell_MouseLeftButtonDown"
        MouseMove="NotchShell_MouseMove"
        MouseLeftButtonUp="NotchShell_MouseLeftButtonUp"
        LostMouseCapture="NotchShell_LostMouseCapture">
