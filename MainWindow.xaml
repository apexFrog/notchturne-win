          <!-- Divider 1 -->
          <Border x:Name="DivLyrics" Grid.Column="1" Width="1" Background="#1E1E22" Margin="14,10,16,10"/>

          <!-- Column 2: Lyrics -->
          <Grid Grid.Column="2" Margin="0,2,0,2">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="LyricsSlide" X="0"/>
            </Grid.RenderTransform>
            <controls:LyricsView x:Name="NotchLyrics" VerticalAlignment="Stretch"/>
