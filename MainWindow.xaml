                <Button x:Name="BtnProgBar" Content="Полоса" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnProgBar"/>
                <Button x:Name="BtnProgDots" Content="Точки" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnProgDots"/>
                <Button x:Name="BtnProgTime" Content="Таймер" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnProgTime"/>
                <Button x:Name="BtnProgCapsule" Content="Капсула" Style="{StaticResource SegPill}" Padding="8,4" Margin="4,0,0,4" Click="OnProgCapsule"/>
