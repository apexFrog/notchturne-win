            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblSideExpand" Text="Боковая панель по краям" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwSideExpand" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid x:Name="SideProgStyleRow">
