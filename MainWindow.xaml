      <!-- Collapsed: Horizontal Arm (Cover + Title) -->
      <Grid x:Name="CornerMiniHoriz" Width="260" Height="42">
        <Grid Margin="12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="7" Background="#1C1C20" Margin="0,0,9,0" VerticalAlignment="Center">
            <Border CornerRadius="7" RenderOptions.BitmapScalingMode="HighQuality">
              <Border.Background>
                <ImageBrush x:Name="CornerMiniArtBrush" Stretch="UniformToFill"/>
              </Border.Background>
            </Border>
          </Border>
          <TextBlock x:Name="CornerMiniText" Grid.Column="1" Foreground="#F2F2F7" FontSize="12" FontWeight="Medium"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ничего не играет"/>
        </Grid>
      </Grid>

      <!-- Collapsed: Corner Junction (Music Visualizer right in the corner bend!) -->
      <Grid x:Name="CornerMiniJunction" Width="58" Height="42">
        <controls:MiniVisualizer x:Name="CornerMiniViz" Width="20" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="CornerMiniDot" Width="7" Height="7" Fill="#1DB954" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
