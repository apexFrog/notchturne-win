<Window x:Class="NotchturneWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NotchturneWin.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="1160" Height="420" Top="0">
  <Window.Resources>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- iOS-style green toggle switch (matching screenshot) -->
    <Style x:Key="IosSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#2E2E33">
              <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="ThumbShift" X="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#34C759"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Compact pill button for segmented choices & steppers -->
    <Style x:Key="SegPill" TargetType="Button">
      <Setter Property="Background" Value="#1E1E22"/>
      <Setter Property="Foreground" Value="#8E8E93"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingRowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingSep" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#18181C"/>
      <Setter Property="Margin" Value="0,9"/>
    </Style>
  </Window.Resources>

  <Grid>
  <Border x:Name="NotchShell" Background="#FF000000" CornerRadius="0,0,26,26"
          BorderBrush="#1AFFFFFF" BorderThickness="1,0,1,1"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          Width="250" Height="34" ClipToBounds="True"
          MouseLeftButtonDown="NotchShell_MouseLeftButtonDown"
          MouseMove="NotchShell_MouseMove"
          MouseLeftButtonUp="NotchShell_MouseLeftButtonUp"
          LostMouseCapture="NotchShell_LostMouseCapture">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem x:Name="CtxSettings" Header="Настройки…" Click="OpenSettings"/>
        <MenuItem x:Name="CtxCycleMode" Header="Сменить режим текста" Click="CycleLyricsMode"/>
        <MenuItem x:Name="CtxResetPos" Header="Сбросить позицию (вверх по центру)" Click="ResetNotchPosition"/>
        <Separator/>
        <MenuItem x:Name="CtxQuit" Header="Выход" Click="Quit"/>
      </ContextMenu>
    </Border.ContextMenu>

    <Grid>
      <!-- Ambient Cover / Glass Glow & Shimmer Layers (clipped via exact PathGeometry, zero VisualBrush offset) -->
      <Grid x:Name="NotchBgContainer" IsHitTestVisible="False" SizeChanged="NotchBgContainer_SizeChanged">
        <Border x:Name="NotchGlowLayer" IsHitTestVisible="False" Visibility="Collapsed"/>
        <controls:CoverShimmerLayer x:Name="NotchShimmer" IsHitTestVisible="False" Visibility="Collapsed"/>
      </Grid>

      <!-- Collapsed Mini Bar -->
      <Grid x:Name="Mini" Margin="14,0" VerticalAlignment="Center" Height="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="MiniArtBox" Width="20" Height="20" CornerRadius="6" Background="#1C1C20" Margin="0,0,9,0" VerticalAlignment="Center">
          <Border x:Name="MiniArtLayer" CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
            <Border.Background>
              <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
            </Border.Background>
          </Border>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="MiniText" Foreground="#F2F2F7" FontSize="12" FontWeight="Medium"
                     TextTrimming="CharacterEllipsis" Text="Ничего не играет"/>
          <TextBlock x:Name="MiniLyricText" Foreground="#B8B8C2" FontSize="11.5" FontWeight="Normal"
                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <controls:MiniVisualizer x:Name="MiniViz" Width="18" Height="16" VerticalAlignment="Center"/>
          <Ellipse x:Name="MiniDot" Width="6" Height="6" Fill="#1DB954"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- Collapsed Vertical Side Pill (Beta: when snapped to Left or Right edge) -->
      <Grid x:Name="MiniVertical" Margin="0,14" HorizontalAlignment="Center" VerticalAlignment="Stretch" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="MiniVertArtBox" Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="#1C1C20" HorizontalAlignment="Center">
          <Border x:Name="MiniVertArtLayer" CornerRadius="10" RenderOptions.BitmapScalingMode="HighQuality">
            <Border.Background>
              <ImageBrush x:Name="MiniVertArtBrush" Stretch="UniformToFill"/>
            </Border.Background>
            <Border CornerRadius="10" BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
          </Border>
        </Border>

        <!-- Multi-style compact progress/timer indicator -->
        <controls:SideProgressIndicator x:Name="SideProgInd" Grid.Row="1" Width="46" Height="64"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
          <controls:MiniVisualizer x:Name="MiniVizVert" Width="20" Height="16" HorizontalAlignment="Center"/>
          <Ellipse x:Name="MiniDotVert" Width="7" Height="7" Fill="#1DB954" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
      </Grid>

      <!-- Expanded Vertical Side Panel (Beta: when snapped to Left or Right edge) -->
      <Grid x:Name="FullVertical" Margin="20,18,20,18" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <ScaleTransform x:Name="FullVertScale" ScaleX="0.97" ScaleY="0.97"/>
        </Grid.RenderTransform>

        <!-- Settings Gear top-right -->
        <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-8,-8,0" Padding="5" ToolTip="Настройки" Click="OpenSettings" Panel.ZIndex="10">
          <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                Fill="#6E6E73" Stretch="Uniform" Width="14" Height="14"/>
        </Button>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top Player Block -->
          <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
            <!-- Large Centered Rounded HD Cover -->
            <Grid Width="132" Height="132" HorizontalAlignment="Center" Margin="0,2,0,12">
              <Border CornerRadius="20" Background="#1A1A1E">
                <Border.Effect>
                  <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <Border CornerRadius="20" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background>
                    <ImageBrush x:Name="ArtVertBrush" Stretch="UniformToFill"/>
                  </Border.Background>
                  <Border CornerRadius="20" BorderBrush="#2AFFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
                </Border>
              </Border>
              <Border x:Name="SourceBadgeVert" Width="24" Height="24" CornerRadius="8"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7"
                      Background="#FA2D48" BorderBrush="#CC000000" BorderThickness="1.5" Visibility="Collapsed">
                <TextBlock x:Name="SourceBadgeTextVert" Text="♪" Foreground="White" FontSize="11.5" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>

            <!-- Title & Artist -->
            <TextBlock x:Name="TitleTextVert" Text="Ничего не играет" Foreground="White" FontSize="16"
                       FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0"/>
            <TextBlock x:Name="ArtistTextVert" Text="" Foreground="#9A9AA2" FontSize="12.5"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,2,6,10"/>

            <!-- Seek Bar -->
            <Grid x:Name="SeekTrackVert" Height="14" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="SeekVertDown" MouseMove="SeekVertMove">
              <Border Height="3.5" CornerRadius="2" Background="#3A3A3C" VerticalAlignment="Center"/>
              <Border x:Name="ProgressFillVert" Height="3.5" CornerRadius="2" Background="White"
                      HorizontalAlignment="Left" Width="0" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,2,0,8">
              <TextBlock x:Name="ElapsedTextVert" Text="0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Left"/>
              <TextBlock x:Name="RemainingTextVert" Text="-0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Playback Controls -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Button x:Name="ModeQuickBtnVert" Style="{StaticResource IconBtn}" Padding="4" Click="CycleLyricsMode"
                      ToolTip="Сменить режим текста">
                <TextBlock Text="♪" Foreground="#FF3B5C" FontSize="14" FontWeight="Bold"/>
              </Button>

              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Padding="10,4" Click="Prev" ToolTip="Предыдущий">
                  <Path Data="M11,18V6l-8.5,6L11,18z M11.5,12l8.5,6V6L11.5,12z"
                        Fill="White" Stretch="Uniform" Width="18" Height="14"/>
                </Button>
                <Button Style="{StaticResource IconBtn}" Padding="12,4" Click="PlayPause" ToolTip="Пауза / Воспроизведение">
                  <Path x:Name="PlayPauseIconVert" Data="M8,5v14l11-7L8,5z"
                        Fill="White" Stretch="Uniform" Width="16" Height="17"/>
                </Button>
                <Button Style="{StaticResource IconBtn}" Padding="10,4" Click="Next" ToolTip="Следующий">
                  <Path Data="M4,18l8.5-6L4,6V18z M13,6v12l8.5-6L13,6z"
                        Fill="White" Stretch="Uniform" Width="18" Height="14"/>
                </Button>
              </StackPanel>

              <Button x:Name="SourceStatusBtnVert" Grid.Column="2" Style="{StaticResource IconBtn}" Padding="4" Click="OpenSettings"
                      ToolTip="Источник медиа (настройки)">
                <Border x:Name="SourceStatusDotVert" Width="14" Height="14" CornerRadius="7" Background="#1DB954">
                  <TextBlock Text="✓" Foreground="Black" FontSize="9" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Button>
            </Grid>
          </StackPanel>

          <!-- Horizontal Divider & Optional Compact Tab Switcher -->
          <StackPanel x:Name="SideBottomHeader" Grid.Row="1" Margin="0,12,0,8">
            <Border Height="1" Background="#24FFFFFF" Margin="0,0,0,8"/>
            <StackPanel x:Name="SideTabRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
              <Button x:Name="BtnSideTabLyrics" Content="Текст" Style="{StaticResource SegPill}" Padding="10,3" Margin="0,0,4,0" Click="OnSideTabLyrics"/>
              <Button x:Name="BtnSideTabCal" Content="Календарь" Style="{StaticResource SegPill}" Padding="10,3" Margin="0,0,4,0" Click="OnSideTabCal"/>
              <Button x:Name="BtnSideTabClip" Content="Буфер" Style="{StaticResource SegPill}" Padding="10,3" Click="OnSideTabClip"/>
            </StackPanel>
          </StackPanel>

          <!-- Bottom Content Area: Lyrics / Calendar / Clipboard -->
          <Grid x:Name="SideBottomContent" Grid.Row="2">
            <controls:LyricsView x:Name="SideLyrics" VerticalAlignment="Stretch"/>

            <Grid x:Name="SideCalendarPanel" VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="SideCalMonthTitle" Text="NOVEMBER 2026" Foreground="#8E8E93" FontSize="11"
                         FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <UniformGrid x:Name="SideCalWeekdaysGrid" Grid.Row="1" Columns="7" Margin="0,0,0,6"/>
              <UniformGrid x:Name="SideCalDaysGrid" Grid.Row="2" Columns="7"/>
            </Grid>

            <Grid x:Name="SideClipboardPanel" VerticalAlignment="Stretch" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SideClipList"/>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <!-- Expanded Wide Notch (Player + Lyrics + Calendar + Clipboard) -->
      <Grid x:Name="Full" Margin="20,16,20,16" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
          <ScaleTransform x:Name="FullScale" ScaleX="0.97" ScaleY="0.97"/>
        </Grid.RenderTransform>
        <!-- Settings Gear top-right -->
        <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-8,-8,0" Padding="5" ToolTip="Настройки" Click="OpenSettings" Panel.ZIndex="10">
          <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                Fill="#6E6E73" Stretch="Uniform" Width="14" Height="14"/>
        </Button>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColPlayer" Width="340"/>
            <ColumnDefinition x:Name="ColLyricsDiv" Width="Auto"/>
            <ColumnDefinition x:Name="ColLyrics" Width="230"/>
            <ColumnDefinition x:Name="ColCalDiv" Width="Auto"/>
            <ColumnDefinition x:Name="ColCal" Width="188"/>
            <ColumnDefinition x:Name="ColClipDiv" Width="Auto"/>
            <ColumnDefinition x:Name="ColClip" Width="178"/>
          </Grid.ColumnDefinitions>

          <!-- Column 1: Media Player -->
          <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="122"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Width="116" Height="116" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Border CornerRadius="18" Background="#1A1A1E">
                <Border.Effect>
                  <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
                </Border.Effect>
                <Border x:Name="ArtBorder" CornerRadius="18" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background>
                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                  </Border.Background>
                  <Border CornerRadius="18" BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
                </Border>
              </Border>
              <Border x:Name="SourceBadge" Width="22" Height="22" CornerRadius="7"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                      Background="#FA2D48" BorderBrush="#CC000000" BorderThickness="1.5" Visibility="Collapsed">
                <TextBlock x:Name="SourceBadgeText" Text="♪" Foreground="White" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="14,4,4,2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" Text="Ничего не играет" Foreground="White" FontSize="15.5"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Text="" Foreground="#8E8E93" FontSize="12.5"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,12,0,10">
                <Grid x:Name="SeekTrack" Height="14" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="SeekDown" MouseMove="SeekMove">
                  <Border Height="3.5" CornerRadius="2" Background="#3A3A3C" VerticalAlignment="Center"/>
                  <Border x:Name="ProgressFill" Height="3.5" CornerRadius="2" Background="White"
                          HorizontalAlignment="Left" Width="0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,2,0,0">
                  <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="RemainingText" Text="-0:00" Foreground="#7A7A80" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>

              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ModeQuickBtn" Style="{StaticResource IconBtn}" Padding="4" Click="CycleLyricsMode"
                        ToolTip="Сменить режим текста">
                  <TextBlock x:Name="ModeQuickGlyph" Text="♪" Foreground="#FF3B5C" FontSize="14" FontWeight="Bold"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconBtn}" Padding="8,4" Click="Prev" ToolTip="Предыдущий">
                    <Path Data="M11,18V6l-8.5,6L11,18z M11.5,12l8.5,6V6L11.5,12z"
                          Fill="White" Stretch="Uniform" Width="17" Height="13"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Padding="10,4" Click="PlayPause" ToolTip="Пауза / Воспроизведение">
                    <Path x:Name="PlayPauseIcon" Data="M8,5v14l11-7L8,5z"
                          Fill="White" Stretch="Uniform" Width="15" Height="16"/>
                  </Button>
                  <Button Style="{StaticResource IconBtn}" Padding="8,4" Click="Next" ToolTip="Следующий">
                    <Path Data="M4,18l8.5-6L4,6V18z M13,6v12l8.5-6L13,6z"
                          Fill="White" Stretch="Uniform" Width="17" Height="13"/>
                  </Button>
                </StackPanel>

                <Button x:Name="SourceStatusBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Padding="4" Click="OpenSettings"
                        ToolTip="Источник медиа (настройки)">
                  <Border x:Name="SourceStatusDot" Width="14" Height="14" CornerRadius="7" Background="#1DB954">
                    <TextBlock Text="✓" Foreground="Black" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
