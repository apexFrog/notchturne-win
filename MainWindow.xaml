            <!-- WHAT TO SHOW -->
            <TextBlock x:Name="LblSecShow" Text="ЧТО ПОКАЗЫВАТЬ" Foreground="#6E6E73" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Grid>
              <TextBlock x:Name="LblShowLyrics" Text="Текст песни" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwLyrics" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblShowCal" Text="Календарь" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwCalendar" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
            </Grid>
            <Border Style="{StaticResource SettingSep}"/>

            <Grid>
              <TextBlock x:Name="LblShowClip" Text="Буфер обмена" Style="{StaticResource SettingRowLabel}"/>
              <CheckBox x:Name="SwClipboard" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" Click="OnInlineToggle"/>
